    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="380dp"
        android:layout_height="200dp"
        android:layout_marginTop="120dp"
        android:layout_centerHorizontal="true" /> <!-- Make it 90% of the screen width -->



    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profileImage"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="25dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/pfp"
        app:shapeAppearanceOverlay="@style/CircularShape" />

    <TextView
        android:id="@+id/greetingTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Good Evening!"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:layout_marginStart="190dp"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text=""
        android:id="@+id/usernamee"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:layout_marginTop="85dp"
        android:layout_marginStart="190dp"
        />



    <ImageButton
        android:id="@+id/workoutlst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="530dp"
        android:padding="0dp"
        android:src="@drawable/wrk"
        />

    <ImageButton
        android:id="@+id/nutrihelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="200dp"
        android:padding="0dp"
        android:layout_marginTop="470dp"
        android:src="@drawable/nutri"
        />

    <ImageButton
        android:id="@+id/waterr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="330dp"
        android:padding="0dp"
        android:src="@drawable/water"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/workoutlst" />

    <ImageButton
        android:id="@+id/bmibmr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="210dp"
        android:layout_marginTop="330dp"
        android:padding="0dp"
        android:src="@drawable/bmibmr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/workoutlst"/>

    <Button
        android:id="@+id/signOutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="Sign Out"
        android:textColor="@color/black"
        android:textSize="18dp"
        android:layout_centerHorizontal="true"
        app:cornerRadius="10dp"
        android:layout_marginTop="650dp"/>


</RelativeLayout>