<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".backkk"
    android:background="#817F8F">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="90dp" />


    <ImageButton
        android:id="@+id/bac"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/chestback" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/textchoose"
        android:layout_marginTop="150dp"
        android:layout_marginStart="30dp"/>
    <ImageButton
        android:layout_width="320dp"
        android:layout_height="71dp"
        android:src="@drawable/bentoverrow"
        android:id="@+id/bentoverr"
        android:padding="0dp"
        android:layout_marginTop="250dp"
        android:layout_marginStart="25dp" />

    <ImageButton
        android:layout_width="320dp"
        android:layout_height="71dp"
        android:src="@drawable/seatedcable"
        android:id="@+id/seatedcable"
        android:padding="0dp"
        android:layout_marginTop="350dp"
        android:layout_marginStart="25dp" />

    <ImageButton
        android:layout_width="320dp"
        android:layout_height="71dp"
        android:src="@drawable/latpuldownn"
        android:id="@+id/latpull"
        android:padding="0dp"
        android:layout_marginTop="450dp"
        android:layout_marginStart="25dp" />


</RelativeLayout>